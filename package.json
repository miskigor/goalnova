{
  "name": "pitchrusch",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "patch-package",
    "dev": "node scripts/dev-with-lan.mjs",
    "lan:url": "node scripts/print-dev-lan-url.mjs",
    "dev:lan": "sh -c 'exec env NEXT_DISABLE_CROSS_SITE_DEV_BLOCK=1 NEXT_DEV_LAN_HOST=\"$(ipconfig getifaddr en0 2>/dev/null || ipconfig getifaddr en1 2>/dev/null)\" npx next dev --hostname 0.0.0.0 --port 3000 --webpack'",
    "dev:mobile": "env NEXT_DISABLE_CROSS_SITE_DEV_BLOCK=1 npx next dev --hostname 0.0.0.0 --port 3002",
    "dev:mobile:webpack": "env NEXT_DISABLE_CROSS_SITE_DEV_BLOCK=1 npx next dev --hostname 0.0.0.0 --port 3002 --webpack",
    "dev:phone": "sh scripts/dev-phone.sh",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "validate:messages": "python3 scripts/validate-messages.py",
    "messages:parity": "node scripts/message-key-parity.mjs",
    "messages:fill": "node scripts/fill-messages-from-en.mjs",
    "music:sync-pixabay": "node scripts/pixabay-music-sync.mjs",
    "db:types": "supabase gen types typescript --schema public --linked > lib/supabase/database.types.ts",
    "db:export-all-sql": "node scripts/build-supabase-all-sql.mjs"
  },
  "dependencies": {
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@supabase/supabase-js": "^2.101.1",
    "ffmpeg-static": "^5.3.0",
    "nanoid": "^5.1.9",
    "next": "16.2.2",
    "next-intl": "^4.9.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "stripe": "^22.1.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.2",
    "patch-package": "^8.0.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
